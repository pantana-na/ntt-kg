# ==============================================================================
# Unified Multi-Environment Configuration Template (.env.example)
# Plant Knowledge Graph (Spanner Hybrid + Graph) & Knowledge Catalog Demo
# Copy this file to .env and set GCP_PROJECT + bucket names before deploying:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Shared / Core Settings
# ------------------------------------------------------------------------------
GCP_PROJECT=your-gcp-project-id
GCP_REGION=asia-southeast1
GENAI_LOCATION=asia-southeast1
DATAPLEX_LOCATION=asia-southeast1
DATAPLEX_GLOSSARY_LOCATION=global

# Version-pinned Vertex AI / Gemini models (invoked natively by Spanner ML.PREDICT)
EMBEDDING_MODEL=text-embedding-005
EMBEDDING_DIMENSION=768
DEFAULT_MODEL=gemini-2.5-pro-001
FAST_MODEL=gemini-2.5-flash-001

# Repository & Local Corpus Paths
GITHUB_REPO=https://github.com/pantana-na/ntt-kg.git
ARTIFACT_REGISTRY_REPO=plant-kg-repo
OKF_BUNDLE_DIR=okf_bundle
ACTIVE_ENV=nonprod

# Ingestion & Batching Controls
SPANNER_EMBED_BATCH_SIZE=20
SPANNER_MUTATION_BATCH_SIZE=200
MAX_RETRY_ATTEMPTS=5

# FinOps Resource Labels
FINOPS_OWNER=demo-owner
FINOPS_COST_CENTER=demo
FINOPS_SERVICE=plant-kg-demo

# ------------------------------------------------------------------------------
# 2. Non-Prod / PoC Demo Configuration Block (NONPROD_*)
# ------------------------------------------------------------------------------
NONPROD_ENVIRONMENT_NAME=demo
NONPROD_GCS_BUCKET=your-gcp-project-id-okf-bundle
NONPROD_GCS_PREFIX=okf_bundle
NONPROD_SPANNER_INSTANCE=ntt-kg-demo
NONPROD_SPANNER_DISPLAY_NAME="Plant Knowledge Graph"
NONPROD_SPANNER_DATABASE=plant-kg
NONPROD_SPANNER_EDITION=ENTERPRISE
NONPROD_SPANNER_PROCESSING_UNITS=100
NONPROD_SPANNER_MODEL_NAME=OkfEmbeddingModel
NONPROD_SPANNER_GRAPH_NAME=PlantKnowledgeGraph
NONPROD_DATAPLEX_ENTRY_GROUP=okf-plant-knowledge
NONPROD_DATAPLEX_ENTRY_TYPE=okf-knowledge-asset
NONPROD_DATAPLEX_ASPECT_TYPE=okf-plant-asset-aspect
NONPROD_DATAPLEX_GLOSSARY_ID=okf-plant-glossary

# ------------------------------------------------------------------------------
# 3. Production Configuration Block (PROD_* — Reference Template)
# ------------------------------------------------------------------------------
PROD_ENVIRONMENT_NAME=production
PROD_GCS_BUCKET=your-gcp-project-id-okf-bundle-prod
PROD_GCS_PREFIX=okf_bundle
PROD_SPANNER_INSTANCE=ntt-kg-prod
PROD_SPANNER_DISPLAY_NAME="Plant Knowledge Graph"
PROD_SPANNER_DATABASE=plant-kg
PROD_SPANNER_EDITION=ENTERPRISE
PROD_SPANNER_PROCESSING_UNITS=1000
PROD_SPANNER_MODEL_NAME=OkfEmbeddingModel
PROD_SPANNER_GRAPH_NAME=PlantKnowledgeGraph
PROD_DATAPLEX_ENTRY_GROUP=okf-plant-knowledge-prod
PROD_DATAPLEX_ENTRY_TYPE=okf-knowledge-asset-prod
PROD_DATAPLEX_ASPECT_TYPE=okf-plant-asset-aspect-prod
PROD_DATAPLEX_GLOSSARY_ID=okf-plant-glossary-prod
